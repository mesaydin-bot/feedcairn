{
  "name": "feedcairn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/check-no-credentials.mjs src-tauri/target/release/bundle",
    "api": "cargo run --manifest-path src-tauri/Cargo.toml --bin feedcairn-web",
    "web": "concurrently -k -n api,ui -c blue,green \"npm run api\" \"npm run ui\"",
    "ui": "vite --host 127.0.0.1 --port 43123",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "typecheck": "tsc --noEmit",
    "check:credentials": "node scripts/check-no-credentials.mjs --source ."
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "marked": "^18.0.13",
    "mermaid": "^11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^8.0.16"
  }
}
